{
  "name": "@nexume/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run dev",
    "dev": "vite build && bun run scripts/electrobun.ts dev",
    "dev:watch": "vite build && bun run scripts/electrobun.ts dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run dev\"",
    "hmr": "vite --port 5173",
    "test": "bun test",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build && bun run scripts/electrobun.ts build --env=stable",
    "build:portable": "bun run build && bun run scripts/build-portable.ts"
  },
  "dependencies": {
    "electrobun": "1.18.1",
    "element-plus": "^2.14.3",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "unplugin-element-plus": "^0.11.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.2.0"
  }
}
